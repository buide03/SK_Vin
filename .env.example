APP_MODE=demo
MODEL_MODE=mock
MODEL_PROVIDER=openai
OPENAI_MODEL=gpt-6-luna
# Put the key in .env or .env.local, only on the server. Never NEXT_PUBLIC_.
OPENAI_API_KEY=
ALLOW_EXTERNAL_MODEL=true
MODEL_TIMEOUT_MS=90000
MAX_MODEL_CONCURRENCY=4
SMALL_CELL_THRESHOLD=10
FOLLOW_UP_DAYS=7
NEXT_TELEMETRY_DISABLED=1
# Optional managed Postgres: set DATABASE_URL only on the server.
# A nonempty DATABASE_URL selects postgres; otherwise local PGlite is used.
# DB_BACKEND=postgres
# Optional: MODEL_PROVIDER=ollama and OLLAMA_MODEL=qwen3:4b
# APP_MODE=live/pilot remains blocked.
